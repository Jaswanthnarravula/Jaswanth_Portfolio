{
  "name": "jaswanth-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jaswanth Narravula — five miniature operating systems that hold one career (Next.js, static).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/check-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check:plans": "node scripts/check-plans.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:perf": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:plans && npm run check:resume",
    "setup:decoders": "node scripts/copy-decoders.mjs",
    "postinstall": "node scripts/copy-decoders.mjs",
    "gltf:inspect": "gltf-transform inspect",
    "gltf:draco": "gltf-transform draco",
    "gltf:meshopt": "gltf-transform meshopt",
    "gltf:ktx2": "gltf-transform uastc",
    "gltf:optimize": "gltf-transform optimize",
    "prebuild": "node scripts/copy-decoders.mjs && node scripts/fetch-github.mjs && npm run build:resume && node --experimental-strip-types --no-warnings scripts/check-content.mjs && node scripts/check-plans.mjs",
    "build:resume": "node --experimental-strip-types --no-warnings scripts/build-resume.mjs",
    "build:hello": "node scripts/build-hello-paths.mjs",
    "build:wordmark": "node --experimental-strip-types --no-warnings scripts/build-wordmark.mjs",
    "assets:ingest": "node --experimental-strip-types --no-warnings scripts/ingest-assets.mjs",
    "check:content": "node --experimental-strip-types --no-warnings scripts/check-content.mjs",
    "check:resume": "node --experimental-strip-types --no-warnings scripts/build-resume.mjs --check",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e:build": "node scripts/e2e-build.mjs",
    "check:build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@gltf-transform/cli": "4.5.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@lhci/cli": "0.15.1",
    "@napi-rs/canvas": "1.0.9",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.1",
    "draco3d": "1.5.7",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "26.1.0",
    "meshoptimizer": "1.2.0",
    "opentype.js": "2.0.0",
    "pdfjs-dist": "6.3.289",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "raw-loader": "4.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vercel": "59.23.2",
    "vitest": "5.0.1",
    "web-vitals": "6.2.2"
  }
}
